import aoc
import file
import testing


def parse_data(data) -> list[(int, int)]:
    ranges = []
    for range in data.split(","):
        parts = range.split("-")
        ranges.append((int(parts[0]), int(parts[1])))
    return ranges

def invalid(digits: str, repeats: int) -> bool:
    if len(digits) % repeats != 0:
        return False
    chunk = int(len(digits) / repeats)
    for i in range(0, chunk):
        for j in range(1, repeats):
            if digits[i] != digits[chunk * j + i]:
                return False
    return True

def part1(data):
    sum = 0
    for a, b in data:
        for ident in range(a, b + 1):
            if invalid(str(ident), 2):
                sum += ident
    return sum

def part2(data):
    sum = 0
    for a, b in data:
        for ident in range(a, b + 1):
            digits = str(ident)
            for r in range(2, len(digits) + 1):
                if invalid(digits, r):
                    sum += ident
                    break
    return sum

sample_data = """11-22,95-115,998-1012,1188511880-1188511890,222220-222224,
1698522-1698528,446443-446449,38593856-38593862,565653-565659,
824824821-824824827,2121212118-2121212124"""

def _test_part1():
    ranges = parse_data(sample_data)
    testing.assertEqual(part1(ranges), 1227775554)

def _test_part2():
    ranges = parse_data(sample_data)
    testing.assertEqual(part2(ranges), 4174379265)

actor main(env):
    f_cap = file.ReadFileCap(file.FileCap(env.cap))
    data = aoc.read_file(f_cap, 'input/d02.txt')
    ranges = parse_data(data)
    # 540147836504 too high
    print("Part 1: ", part1(ranges))
    print("Part 2: ", part2(ranges))
    env.exit(0)
