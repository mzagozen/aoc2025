import aoc
import file
import testing


def combs[T](l: list[T], n: int) -> list[list[T]]:
    if n == 0:
        return [[]]
    res = []
    for i in range(len(l)):
        for c in combs(l[i+1:], n-1):
            res.append([l[i]] + c)
    return res


def parse_data(data: list[str]) -> list[(machine: list[bool], buttons: list[list[int]], joltage: list[int])]:
    res = []
    for line in data:
        parts = line.split(" ")
        machine = [c == "#" for c in parts[0][1:-1]]
        buttons = []
        for b in parts[1:-1]:
            b = b[1:-1]
            buttons.append([int(x) for x in b.split(",")])
        joltage = [int(x) for x in parts[-1][1:-1].split(",")]
        res.append((machine, buttons, joltage))
    return res

def pushy(machine: list[bool], buttons: list[list[int]]) -> int:
    # We only push a button 0 or 1 times (more is just repeating the same
    # state). The order of btton pushes doesn't matter either.
    for n in range(1, len(buttons)+1):
        for combo in combs(buttons, n):
            state = [False for _ in machine]
            for button in combo:
                for b in button:
                    state[b] = not state[b]
            if str(state) == str(machine):
                print("{machine} Found combo: ", combo)
                return len(combo)
    raise ValueError("No solution found")

def part1(data: list[(machine: list[bool], buttons: list[list[int]], joltage: list[int])]) -> int:
    print("Data: ", data)
    count = 0
    for m in data:
        count += pushy(m.machine, m.buttons)
    return count

def part2(data):
    count = 0
    return count

sample_data = r"""[.##.] (3) (1,3) (2) (2,3) (0,2) (0,1) {3,5,4,7}
[...#.] (0,2,3,4) (2,3) (0,4) (0,1,2) (1,2,3,4) {7,5,12,7,2}
[.###.#] (0,1,2,3,4) (0,3,4) (0,1,2,4,5) (1,2) {10,11,11,5,10,5}
"""

def _test_part1():
    machine = parse_data(sample_data.splitlines())
    testing.assertEqual(part1(machine), 7)

def _test_part2():
    machine  = parse_data(sample_data.splitlines())
    # testing.assertEqual(part2(machine), 6)

actor main(env):
    f_cap = file.ReadFileCap(file.FileCap(env.cap))
    data = aoc.read_file(f_cap, 'input/d10.txt')
    machine = parse_data(data.splitlines())
    print("Part 1: ", part1(machine))
    print("Part 2: ", part2(machine))
    env.exit(0)
